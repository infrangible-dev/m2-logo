{
    "name": "infrangible/m2-logo",
    "description": "Lets you upload separate logo images for tablets and smartphones, which replace the standard logo on smaller screens.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Content",
        "mobile logo",
        "different logo for smartphones",
        "responsive logo"
    ],
    "homepage": "https://www.infrangible.dev/modules/logo",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "infrangible/m2-core": "~5.0.7",
        "infrangible/m2-foundation": "~3.0.2",
        "magento/framework": "~103.0.6",
        "magento/module-config": "~101.2.0",
        "magento/module-store": "~101.1.0",
        "magento/module-theme": "~101.1.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\Logo\\": "src"
        }
    }
}
